{
  "mcpServers": {
    "a2a": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/mcp.js"],
      "env": {
        "CLAUDE_PLUGIN_OPTION_DISPLAY_NAME": "${user_config.display_name}",
        "CLAUDE_PLUGIN_OPTION_PORT": "${user_config.port}",
        "CLAUDE_PLUGIN_OPTION_ALLOW_CIDRS": "${user_config.allow_cidrs}",
        "CLAUDE_PLUGIN_OPTION_RELAY_ENABLED": "${user_config.relay_enabled}",
        "CLAUDE_PLUGIN_OPTION_RELAY_URL": "${user_config.relay_url}",
        "CLAUDE_PLUGIN_OPTION_RELAY_CERT_SHA256": "${user_config.relay_cert_sha256}"
      }
    }
  }
}
